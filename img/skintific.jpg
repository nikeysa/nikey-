.loading-circle-daraz_normal { animation: 1s ease-in-out 0s infinite normal=
 none running spinner-rotate-daraz; transform-origin: center center; }

.loading-circle-daraz { animation: 0.6s linear 0s infinite normal none runn=
ing spinner-rotate-daraz; transform-origin: center center; transform-box: f=
ill-box; }

@keyframes spinner-rotate-daraz {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.iweb-lazada-icon { width: 46px; height: 46px; }

.iweb-lazada-icon-small { width: 15px; height: 15px; }

.loading-circle { animation: 1.2s linear 0s infinite normal none running sp=
inner-rotate; transform-origin: center center; }

@keyframes spinner-rotate {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.loading-circle-small { animation: 0.6s linear 0s infinite normal none runn=
ing spinner-rotate; transform-origin: center center; }

.pdp-common-phone-input-v2 .phone-input-wrap { margin: 10px 0px 0px; max-wi=
dth: 335px; }

