@keyframes dialog-show {=20
  0% { transform: translate(-50%, calc(-50% + 48px)); }
  100% { transform: translate(-50%, -50%); }
}

@keyframes dialog-hide {=20
  0% { transform: translate(-50%, -50%); }
  100% { transform: translate(-50%, calc(-50% + 48px)); }
}

@keyframes amSlideDownIn {=20
  0% { opacity: 0; transform: scaleY(0.8); transform-origin: 0px 0px; }
  100% { opacity: 1; transform: scaleY(1); transform-origin: 0px 0px; }
}

@keyframes amSlideDownOut {=20
  0% { opacity: 1; transform: scaleY(1); transform-origin: 0px 0px; }
  100% { opacity: 0; transform: scaleY(0.8); transform-origin: 0px 0px; }
}

@keyframes amSlideUpIn {=20
  0% { opacity: 0; transform: scaleY(0.8); transform-origin: 100% 100%; }
  100% { opacity: 1; transform: scaleY(1); transform-origin: 100% 100%; }
}

@keyframes amSlideUpOut {=20
  0% { opacity: 1; transform: scaleY(1); transform-origin: 100% 100%; }
  100% { opacity: 0; transform: scaleY(0.8); transform-origin: 100% 100%; }
}

@keyframes amSlideRightIn {=20
  0% { opacity: 0; transform: scaleX(0.8); transform-origin: 0px 0px; }
  100% { opacity: 1; transform: scaleX(1); transform-origin: 0px 0px; }
}

@keyframes amSlideRightOut {=20
  0% { opacity: 1; transform: scaleX(1); transform-origin: 0px 0px; }
  100% { opacity: 0; transform: scaleX(0.8); transform-origin: 0px 0px; }
}

@keyframes amSlideLeftIn {=20
  0% { opacity: 0; transform: scaleX(0.8); transform-origin: 100% 0px; }
  100% { opacity: 1; transform: scaleX(1); transform-origin: 100% 0px; }
}

@keyframes amSlideLeftOut {=20
  0% { opacity: 1; transform: scaleX(1); transform-origin: 100% 0px; }
  100% { opacity: 0; transform: scaleX(0.8); transform-origin: 100% 0px; }
}

