eft: 15px; width: 100%; height: 36px; color: rgb(46, 51, 70); font-size: 14=
px; border: 1px solid rgb(227, 231, 241); border-radius: 6px; outline: none=
; }

.pdp-common-phone-input-v2 .phone-input::-webkit-input-placeholder { color:=
 rgb(133, 139, 156); font-weight: 400; font-size: 14px; line-height: 17.75p=
x; }

.pdp-common-phone-input-v2 .phone-input-error { margin-top: 4px; color: rgb=
(255, 0, 102); font-size: 12px; }

.pdp-common-phone-input-v2.error .phone-input { border-color: rgb(255, 0, 1=
02); box-shadow: none; }

