.emoji-symbol-sunglasses { width: 32px; height: 32px; background-position: =
0px -704px; }

.emoji-symbol-tearsofjoy { width: 32px; height: 32px; background-position: =
0px -736px; }

.emoji-symbol-thanks { width: 32px; height: 32px; background-position: 0px =
-768px; }

.emoji-symbol-thumbs { width: 32px; height: 32px; background-position: 0px =
-800px; }

.emoji-symbol-weary { width: 32px; height: 32px; background-position: 0px -=
832px; }

.emoji-symbol-winking { width: 32px; height: 32px; background-position: 0px=
 -864px; }

.emoji-symbol-wow { width: 32px; height: 32px; background-position: 0px -89=
6px; }

.emoji-symbol-yum { width: 32px; height: 32px; background-position: 0px -92=
8px; }

.message-row { padding: 0px 0px 20px; display: flex; }

.message-row.user-type-2 { flex-direction: row-reverse; }

.message-row.row-card-product { padding-top: 15px; }

.message-row .avatar-holder, .message-row .simple-avatar { width: 40px; min=
-width: 40px; height: 40px; margin: 0px 5px; }

.message-row .read-type { align-self: flex-end; margin: 0px 6px 4px; color:=
 rgb(153, 153, 153); font-size: 14px; }

.message-row .unread-type { color: rgb(0, 29, 233); }

.message-row .message-read-type { width: 100%; text-align: right; }

.message-row .message-process-result { max-width: 200px; align-self: flex-e=
nd; }

.message-row .clickable { cursor: pointer; }

.row-card-system .message-contain { width: 100%; }

.message-contain { position: relative; display: flex; flex-direction: colum=
n; font-size: 12px; }

.message-contain .message-withdraw { background: rgb(255, 255, 255); border=
-radius: 5px; padding: 7px 5px 3px; position: absolute; left: -27px; bottom=
: 16px; }

.message-contain .message-withdraw-active { display: none; }

.message-contain .message-icon-box { height: 32px; display: flex; align-ite=
ms: center; justify-content: flex-end; }

.message-contain .message-icon-box .dislike-icon, .message-contain .message=
-icon-box .like-icon { width: 16px; height: 16px; cursor: pointer; }

.message-contain .message-icon-box .like-icon { margin-left: 20px; }

.message-contain .message-icon-box .noDrap { cursor: no-drop; }

.withdrawBalloon { padding: 10px !important; }

.withdrawBalloon { font-size: 12px; }

@keyframes fadeIn {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes fadeInDown {=20
  0% { opacity: 0; transform: translateY(-100px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fadeInDownBig {=20
  0% { opacity: 0; transform: translateY(-2000px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fadeInLeft {=20
  0% { opacity: 0; transform: translate(-20px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes fadeInLeftBig {=20
  0% { opacity: 0; transform: translate(-2000px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes fadeInRight {=20
  0% { opacity: 0; transform: translate(20px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes fadeInRightBig {=20
  0% { opacity: 0; transform: translate(2000px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes fadeInUp {=20
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fadeInUpBig {=20
  0% { opacity: 0; transform: translateY(2000px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fadeOut {=20
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes fadeOutDown {=20
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(20px); }
}

@keyframes fadeOutDownBig {=20
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(2000px); }
}

@keyframes fadeOutLeft {=20
  0% { opacity: 1; transform: translate(0px); }
  100% { opacity: 0; transform: translate(-20px); }
}

@keyframes fadeOutLeftBig {=20
  0% { opacity: 1; transform: translate(0px); }
  100% { opacity: 0; transform: translate(-2000px); }
}

@keyframes fadeOutRight {=20
  0% { opacity: 1; transform: translate(0px); }
  100% { opacity: 0; transform: translate(20px); }
}

@keyframes fadeOutRightBig {=20
  0% { opacity: 1; transform: translate(0px); }
  100% { opacity: 0; transform: translate(2000px); }
}

@keyframes fadeOutUp {=20
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(-100px); }
}

@keyframes fadeOutUpBig {=20
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(-2000px); }
}

@keyframes slideInDown {=20
  0% { opacity: 0; transform: translateY(-2000px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes slideInLeft {=20
  0% { opacity: 0; transform: translate(-2000px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes slideInRight {=20
  0% { opacity: 0; transform: translate(2000px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes slideInUp {=20
  0% { opacity: 0; transform: translateY(2000px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes slideOutDown {=20
  0% { transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(2000px); }
}

@keyframes slideOutLeft {=20
  0% { transform: translate(0px); }
  100% { opacity: 0; transform: translate(-2000px); }
}

@keyframes slideOutRight {=20
  0% { transform: translate(0px); }
  100% { opacity: 0; transform: translate(2000px); }
}

@keyframes slideOutUp {=20
  0% { transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(-2000px); }
}

@keyframes zoomIn {=20
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  50% { opacity: 1; }
}

@keyframes zoomInPulse {=20
  0% { transform: scaleZ(1); }
  50% { transform: scale3d(1.8, 1.8, 1.8); }
  100% { transform: scale3d(1.4, 1.4, 1.4); }
}

@keyframes zoomInQuick {=20
  0% { opacity: 0; transform: scale(0.8); }
  100% { transform: scale(1); }
}

@keyframes zoomInDown {=20
  0% { animation-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19); o=
pacity: 0; transform: scale3d(0.1, 0.1, 0.1) translate3d(0px, -1000px, 0px)=
; }
  60% { animation-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1); opa=
city: 1; transform: scale3d(0.475, 0.475, 0.475) translate3d(0px, 60px, 0px=
); }
}

@keyframes zoomInLeft {=20
  0% { animation-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19); o=
pacity: 0; transform: scale3d(0.1, 0.1, 0.1) translate3d(-1000px, 0px, 0px)=
; }
  60% { animation-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1); opa=
city: 1; transform: scale3d(0.475, 0.475, 0.475) translate3d(10px, 0px, 0px=
); }
}

@keyframes zoomInRight {=20
  0% { animation-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19); o=
pacity: 0; transform: scale3d(0.1, 0.1, 0.1) translate3d(1000px, 0px, 0px);=
 }
  60% { animation-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1); opa=
city: 1; transform: scale3d(0.475, 0.475, 0.475) translate3d(-10px, 0px, 0p=
x); }
}

@keyframes zoomInUp {=20
  0% { animation-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19); o=
pacity: 0; transform: scale3d(0.1, 0.1, 0.1) translate3d(0px, 1000px, 0px);=
