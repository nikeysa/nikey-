  100% { transform: translate(-50%, calc(-50% + 24px)); }
}

@keyframes toast-hide {=20
  0% { transform: translate(-50%, calc(-50% + 24px)); }
  100% { transform: translate(-50%, -50%); }
}

@keyframes mask-opacity {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes mask-opacity-hide {=20
  0% { display: unset; opacity: 1; }
  100% { display: none; opacity: 0; }
}
